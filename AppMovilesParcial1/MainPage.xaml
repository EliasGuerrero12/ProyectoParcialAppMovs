<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.MainPage"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Image Source="miloj.jpg"
               Aspect="AspectFill" />

        <Label Text="MILO J"
                   FontSize="40"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   FontAttributes="Bold"/>
        <VerticalStackLayout
                   Padding="30"
                   Spacing="20"
                   VerticalOptions="Center">

            <Button Text="BIOGRAFIA"
                    BackgroundColor="Beige"
                    Clicked="OnBiografiaClicked"/>

            <Button Text="DISCOGRAFIA"
                    BackgroundColor="Beige"
                    Clicked="OnDiscografiaClicked"/>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
