<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.MainPage">

    <ScrollView>
        <VerticalStackLayout 
             Padding="20"
             Spacing="20"
             VerticalOptions="Center"
             HorizontalOptions="Center">

            <Label 
                Text="Milo J"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Image 
                Source="miloj.jpg"
                HeightRequest="250"
                Aspect="AspectFill"/>

            <Button
                Text="Ver Biografía"
                Clicked="OnBiografiaClicked"/>

            <Button
                Text="Ver Discografía"
                Clicked="OnDiscografiaClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
