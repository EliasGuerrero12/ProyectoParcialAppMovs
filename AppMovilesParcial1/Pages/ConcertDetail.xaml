<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppMovilesParcial1.Pages.ConcertDetail"
    Title="Detalle del concierto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Image x:Name="ConcertImage"
                   HeightRequest="200"
                   Aspect="AspectFit"/>

            <Label x:Name="ConcertTitle"
                   FontSize="24"
                   FontAttributes="Bold"/>

            <Label x:Name="ConcertDate"/>

            <Label x:Name="ConcertPlace"/>

            <Label x:Name="ConcertDescription"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
