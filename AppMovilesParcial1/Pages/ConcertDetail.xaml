<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.ConcertDetail"
             Title="Detalle del concierto">

    <Grid>

        <Image Source="{StaticResource MainBackgroundImage}"
               Aspect="AspectFill"
               Opacity="0.25"/>

        <BoxView Style="{StaticResource OverlayStyle}"/>

        <ScrollView>
            <VerticalStackLayout Padding="25" Spacing="15">

                <Frame CornerRadius="15"
                       Padding="5"
                       BackgroundColor="White"
                       HorizontalOptions="Center"
                       WidthRequest="215"
                       HeightRequest="215">

                    <Image x:Name="ConcertImage"
                           HeightRequest="200"
                           WidthRequest="200"
                           Aspect="AspectFit"/>
                </Frame>

                <Label x:Name="ConcertTitle"
                       Style="{StaticResource BoldTitleStyle}"/>

                <Label x:Name="ConcertDate"
                       Style="{DynamicResource AccentTextStyle}"/>

                <Label x:Name="ConcertPlace"
                       Style="{DynamicResource AccentTextStyle}"/>

                <Label x:Name="ConcertDescription"
                       Style="{StaticResource DescriptionStyle}"
                       MaxLines="4"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>