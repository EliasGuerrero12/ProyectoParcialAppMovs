<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppMovilesParcial1.Pages.ConcertDetail"
    Title="Detalle del concierto">

    <Grid>
        
        <Image Source="miloj.jpg" 
               Aspect="AspectFill"
               Opacity="0.25"/>

        
        <BoxView Color="Black" 
                 Opacity="0.3"/>

       
        <ScrollView>
            <VerticalStackLayout 
                Padding="25" 
                Spacing="15"
                VerticalOptions="Center">

              
                <Frame CornerRadius="15"
                       Padding="5"
                       BackgroundColor="White"
                       HorizontalOptions="Center"
                       WidthRequest="215"
                       HeightRequest="215">

                    <Image x:Name="ConcertImage" 
                           HeightRequest="200" 
                           WidthRequest="200"
                           Aspect="AspectFit"/>
                </Frame>

              
                <Label x:Name="ConcertTitle" 
                       FontSize="26" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

               
                <HorizontalStackLayout 
                    HorizontalOptions="Center"
                    Spacing="5"
                    Margin="0,5">
                    <Label 
                           FontSize="14"
                           TextColor="Yellow"/>
                    <Label x:Name="ConcertDate" 
                           FontSize="14" 
                           TextColor="Yellow"/>
                </HorizontalStackLayout>

                
                <HorizontalStackLayout 
                    HorizontalOptions="Center"
                    Spacing="5"
                    Margin="0,5">
                    <Label 
                           FontSize="14"
                           TextColor="Gray"/>
                    <Label x:Name="ConcertPlace" 
                           FontSize="14" 
                           TextColor="Gray"/>
                </HorizontalStackLayout>

                
                <Label x:Name="ConcertDescription" 
                       FontSize="15" 
                       TextColor="PeachPuff"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="4"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>