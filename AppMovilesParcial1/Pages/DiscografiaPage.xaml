<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.DiscografiaPage"
             Title="Discografia">

    <Grid>
       
        <Image Source="miloj3.jpg"
               Aspect="AspectFill" />

        <VerticalStackLayout Padding="20" Spacing="15">

           
            <Label 
                Text="DISCOGRAFIA"
                HorizontalOptions="Center"
                FontSize="50"
                FontFamily="SuperPopstar"
                FontAttributes="Bold"
                TextColor="#941f1f"/>

            
            <ListView x:Name="albumsListView"
                      ItemSelected="OnAlbumSelected"
                      BackgroundColor="Transparent"
                      SeparatorColor="#941f1f">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Name}"
                                  Detail="{Binding Year}"
                                  TextColor="White"
                                  DetailColor="#941f1f" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>