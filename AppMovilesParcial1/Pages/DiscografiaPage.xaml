<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.DiscografiaPage">

    <Grid>

        <Image Source="milocon.jpg"
               Opacity="0.3"
       Aspect="AspectFill"
       HorizontalOptions="Fill"
       VerticalOptions="Fill" />

        <BoxView Style="{StaticResource OverlayStyle}"/>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="DISCOGRAFÍA"
       Style="{DynamicResource MainTitleStyle}"
       FontFamily="SuperPopstar"/>

            <ListView x:Name="albumsListView"
                      BackgroundColor="{StaticResource TransparentBg}"
                      SeparatorColor="{DynamicResource PrimaryColor}"
                      ItemSelected="OnAlbumSelected">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Name}"
                                  Detail="{Binding Year}"
                                  TextColor="{StaticResource WhiteText}"
                                  DetailColor="{DynamicResource PrimaryColor}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </VerticalStackLayout>
    </Grid>
</ContentPage>