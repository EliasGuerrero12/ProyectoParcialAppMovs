<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.DiscografiaPage"
             Title="DiscografiaPage">

    <Grid>

        <Image Source="miloj3.jpg" Aspect="AspectFill" Opacity="0.3"/>
        <BoxView Style="{StaticResource OverlayStyle}"/>

        <ListView x:Name="albumsListView"
                  ItemSelected="OnAlbumSelected">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}"
                              Detail="{Binding Year}"/>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</ContentPage>