<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.Concerts">

    <Grid>

        <Image Source="miloj4.jpg"
               Opacity="0.3"
       Aspect="AspectFill"
       HorizontalOptions="Fill"
       VerticalOptions="Fill" />

        <BoxView Style="{StaticResource OverlayStyle}"/>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="CONCIERTOS Y GIRAS"
       Style="{DynamicResource MainTitleStyle}"
       FontFamily="SuperPopstar"/>

            <ListView x:Name="concertsListView"
                      BackgroundColor="{StaticResource TransparentBg}"
                      SeparatorColor="{DynamicResource PrimaryColor}"
                      ItemSelected="OnConcertSelected">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding NameConcert}"
                                  Detail="{Binding Date}"
                                  TextColor="{StaticResource WhiteText}"
                                  DetailColor="{DynamicResource PrimaryColor}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </VerticalStackLayout>
    </Grid>
</ContentPage>