<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.Discografia"
             Title="Discografia">

    <!--listview para mostrar la discografía de Milo J, con un fondo que combina una imagen y un BoxView para crear un efecto visual atractivo. 
    El contenido principal se organiza en un ListView para mostrar los álbumes, con texto formateado para mejorar la presentación.-->

    <Grid>

        <Image Source="miloj3.jpg"
               Aspect="AspectFill"
               Opacity="0.3"/>
        <BoxView Color="Black" 
                 Opacity="0.2"/>
        <ListView x:Name="albumsListView"
          ItemSelected="OnAlbumSelected">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}"
                      Detail="{Binding Year}" />
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>

</ContentPage>