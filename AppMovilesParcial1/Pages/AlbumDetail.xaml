<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.AlbumDetail"
             Title="AlbumDetail">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Image x:Name="AlbumImage" HeightRequest="200" Aspect="AspectFill" />

        <Label x:Name="AlbumTitle" FontSize="24" FontAttributes="Bold" />

        <Label x:Name="AlbumArtist" FontSize="18" TextColor="Gray" />

        <Label x:Name="AlbumReleaseDate" FontSize="16" TextColor="DarkGray" />

        <Label x:Name="AlbumDescription" FontSize="16" TextColor="DarkGray" />

    </VerticalStackLayout>
</ContentPage>