<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.AlbumDetail"
             Title="AlbumDetail">

    <!--Diseño para mostrar los detalles de un álbum seleccionado, incluyendo su imagen, título, artista, 
    fecha de lanzamiento y descripción. El fondo tiene una imagen con opacidad para crear un efecto visual atractivo.-->
    <Grid>

        <Image Source="miloj.jpg" 
               Aspect="AspectFill"
               Opacity="0.25"/>

        <BoxView Color="Black" 
                 Opacity="0.3"/>

        <VerticalStackLayout 
            Padding="25" 
            Spacing="15"
            VerticalOptions="Center">

            
            <Frame CornerRadius="15"
                   Padding="5"
                   BackgroundColor="White"

                   HorizontalOptions="Center"
                   WidthRequest="215"
                   HeightRequest="215">
                
                <Image x:Name="AlbumImage" 
                       HeightRequest="200" 
                       WidthRequest="200"
                       Aspect="AspectFit"/>
            </Frame>

       
           

            <Label x:Name="AlbumTitle" 
                   FontSize="26" 
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="AlbumArtist" 
                   FontSize="18" 
                   TextColor="Yellow"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center"/>

           
            <HorizontalStackLayout 
                HorizontalOptions="Center"
                                   
                Spacing="5"
                Margin="0,5">
                <Label FontSize="14"
                       TextColor="Gray"/>
                <Label x:Name="AlbumReleaseDate" 
                       FontSize="14" 
                       TextColor="Gray"/>
            </HorizontalStackLayout>

            <Label x:Name="AlbumDescription" 
                   FontSize="15" 
                   TextColor="PeachPuff"
                   HorizontalTextAlignment="Center"
                   MaxLines="3"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>