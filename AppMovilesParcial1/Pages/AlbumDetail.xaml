<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.AlbumDetail">

    <Grid>

        <Image Source="{StaticResource MainBackgroundImage}"
               Aspect="AspectFill"
               Opacity="0.25"/>

        <BoxView Style="{StaticResource OverlayStyle}"/>

        <VerticalStackLayout Padding="25" Spacing="15" VerticalOptions="Center">

            <Frame CornerRadius="15"
                   Padding="5"
                   BackgroundColor="White"
                   HorizontalOptions="Center"
                   WidthRequest="215"
                   HeightRequest="215">

                <Image x:Name="AlbumImage"
                       Aspect="AspectFit"/>
            </Frame>

            <Label x:Name="AlbumTitle"
                   Style="{StaticResource BoldTitleStyle}"/>

            <Label x:Name="AlbumArtist"
                   Style="{DynamicResource AccentTextStyle}"
                   FontAttributes="Italic"/>

            <Label x:Name="AlbumReleaseDate"
                   Style="{DynamicResource AccentTextStyle}"/>

            <Label x:Name="AlbumDescription"
                   Style="{StaticResource DescriptionStyle}"
                   MaxLines="3"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>