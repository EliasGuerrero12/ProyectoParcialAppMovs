<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.MainPage"
             Shell.NavBarIsVisible="False">

    
    <Grid>

        <Image Source="{DynamicResource MainBackgroundImage}"
               Aspect="AspectFill" />

        
        <Grid Padding="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Switch Grid.Row="0"
        HorizontalOptions="End"
        OnColor="{DynamicResource PrimaryColor}"
        Toggled="OnToggledChanged"
        VerticalOptions="End"/>


            <Label Grid.Row="1"
       Text="MILO J"
       Style="{StaticResource HeroTitleStyle}"/>

        </Grid>

    </Grid>
</ContentPage>