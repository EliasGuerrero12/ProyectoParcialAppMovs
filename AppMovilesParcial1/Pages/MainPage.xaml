<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.MainPage"
             Shell.NavBarIsVisible="False">

    <!--mainpage con un diseño sencillo pero impactante, utilizando una imagen de fondo que ocupa toda la pantalla y un título centrado con una fuente llamativa para destacar el nombre del artista. El diseño es minimalista, enfocándose en la imagen y el texto para crear una primera impresión fuerte y atractiva para los usuarios al ingresar a la aplicación.-->
    <Grid>
        <Image Source="miloj.jpg"
               Aspect="AspectFill" />

        <Label Text="MILO J"
                   FontSize="85"
                   FontFamily="SuperPopstar"
                   TextColor="Beige"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontAttributes="Bold"/>
    </Grid>

</ContentPage>
