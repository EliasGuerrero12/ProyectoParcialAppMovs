<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.MainPage"
             Shell.NavBarIsVisible="False">

    <!-- mismo fondo -->
    <Grid>

        <Image Source="{StaticResource MainBackgroundImage}"
               Aspect="AspectFill" />

        <!-- Grid interno como el PDF -->
        <Grid Padding="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== SWITCH (igual al PDF) ===== -->
            <Switch Grid.Row="0"
        Style="{StaticResource ThemeSwitchStyle}"
        Toggled="OnThemeChanged"/>

            <!-- ===== CONTENIDO CENTRAL ===== -->
            <Label Grid.Row="1"
       Text="MILO J"
       Style="{StaticResource HeroTitleStyle}"/>

        </Grid>

    </Grid>
</ContentPage>