<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.Pages.MainPage"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Image Source="miloj.jpg"
               Aspect="AspectFill" />

        <Label Text="MILO J"
                   FontSize="80"
                   FontFamily="SuperPopstar"
                   TextColor="Beige"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontAttributes="Bold"/>

        <VerticalStackLayout
                   Padding="30"
                   Spacing="20"
                   VerticalOptions="End">

            <Button Text="BIOGRAFIA"
                    FontSize="25"
                    FontFamily="Roblox"
                    BackgroundColor="#4393c4"
                    />

            <Button Text="DISCOGRAFIA"
                    FontSize="25"
                    FontFamily="Roblox"
                    BackgroundColor="#4393c4"
                    />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
