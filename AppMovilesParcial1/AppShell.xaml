<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppMovilesParcial1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppMovilesParcial1.Pages"
    Title="AppMovilesParcial1">

    <FlyoutItem Title="Inicio">
        <ShellContent
            ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Biografía">
        <ShellContent
            ContentTemplate="{DataTemplate local:BiografiaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Discografía">
        <ShellContent
            ContentTemplate="{DataTemplate local:DiscografiaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Conciertos">
        <ShellContent
         ContentTemplate="{DataTemplate local:Concerts}" />
    </FlyoutItem>

</Shell>
