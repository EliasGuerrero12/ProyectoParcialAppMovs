<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovilesParcial1.BiografiaPage"
             Title="BiografiaPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label 
            Text="Biografía"
            FontSize="24"
            FontAttributes="Bold"/>

            <Label 
            Text="Milo J es un artista argentino nacido en 2006. Se hizo conocido por su estilo único dentro del rap y el trap latino. Su música combina letras profundas con sonidos modernos. En poco tiempo logró posicionarse como uno de los jóvenes más influyentes en la escena urbana. Ha colaborado con artistas importantes y sus canciones han acumulado millones de reproducciones. 
                 Su carrera continúa creciendo rápidamente dentro de la música urbana."
            FontSize="16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>